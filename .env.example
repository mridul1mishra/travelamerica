# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is git-ignored.

# Travelpayouts (flights via Aviasales; marker for WeGoTrip links).
# Obtain at: https://www.travelpayouts.com/programs
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# RapidAPI — Travel Advisor (hotels).
# Obtain at: https://rapidapi.com/apidojo/api/travel-advisor
RAPIDAPI_KEY=

# WeGoTrip (Things to Do — Travelpayouts tours & activities partner).
# WEGOTRIP_API=https://api.wegotrip.com/v2
# WEGOTRIP_API_KEY=

# Neon DB — subscriber and hotel storage.
# Connection string from: Neon console → your project → Connection Details → .env tab
DATABASE_URL=

# SMTP2GO — transactional email (welcome email + PDF delivery).
# API key: SMTP2GO dashboard → Settings → API Keys
# From email must be a verified sender domain in SMTP2GO.
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=hello@travelsamericas.com
SMTP2GO_FROM_NAME=Travels Americas

# Member registration/sign-in: passwords and email codes, with verification/reset through SMTP2GO.
# Generate a separate random secret (at least 32 characters) for each environment.
# Never use the local development secret on production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.travelsamericas.com
# Enable only when the origin is accessible exclusively through your Cloudflare proxy.
AUTH_TRUST_CLOUDFLARE_PROXY=false

# Security — use independent random values of at least 32 characters.
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Temporarily set true if previously emailed Base64 unsubscribe links must remain valid.
ALLOW_LEGACY_UNSUBSCRIBE_TOKENS=false

# Cloudflare Turnstile: optional for email signup, REQUIRED for production Google hotel ratings.
# Configure both values together; a local rating bypass is available below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only honored in development on localhost:3000 or 127.0.0.1:3000.
# When true, use npm run dev:local to keep the bypassed server bound to loopback.
# Production ignores this setting and always requires Turnstile.
NEXT_PUBLIC_HOTEL_RATINGS_LOCAL_BYPASS=false

# Google Places API (New) — server-side, click-only hotel rating lookups.
# Enable only after Turnstile, allowed hostnames, DB migration and key restrictions are ready.
# Setup: scripts/GOOGLE_PLACES_SETUP.md
GOOGLE_RATINGS_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_RATINGS_DAILY_LIMIT=20
GOOGLE_RATINGS_MONTHLY_LIMIT=500
GOOGLE_RATINGS_IP_HOURLY_LIMIT=5
# Exact production hostnames; localhost:3000 is allowed only in development.
HOTEL_RATINGS_ALLOWED_HOSTNAMES=www.travelsamericas.com,travelsamericas.com
# Leave blank unless the origin is reachable ONLY through your controlled Cloudflare proxy.
# Vercel automatically uses its trusted client-IP header. Other hosts use a shared limiter.
HOTEL_RATINGS_TRUSTED_PROXY=

# NYC itinerary PDF — public URL of the hosted PDF to send in the welcome email.
# Leave blank until the PDF is ready; a placeholder link will be used.
NYC_ITINERARY_PDF_URL=

# Affiliate links (NEXT_PUBLIC_ prefix required — rendered in client components).
# If unset, plain non-affiliate URLs are used as fallback, so links still work.
# SafetyWing: your referral URL from the Ambassador dashboard.
NEXT_PUBLIC_SAFETYWING_URL=
# Airalo: your tracking link from Impact after approval.
NEXT_PUBLIC_AIRALO_URL=
